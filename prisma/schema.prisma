generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Venta {
  id          Int      @id @default(autoincrement())
  producto    String
  categoria   String
  monto       Float
  cantidad    Int
  metodoPago  String
  estado      String
  sucursal    String
  fecha       DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}